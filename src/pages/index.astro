---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import CourseMap from '../components/CourseMap.tsx';
import { allLessons, curriculum, lessonById, lessonHref } from '../data/curriculum';

const base = import.meta.env.BASE_URL;
const entries = await getCollection('lessons');
const available = Object.fromEntries(entries.map((e) => [e.data.id, lessonHref(base, lessonById(e.data.id)!)]));
const first = allLessons.find((l) => available[l.id])!;
---

<Base title="Algebra, step by step">
  <section class="hero">
    <div class="container hero-inner">
      <div>
        <div class="hero-kicker">High-school &amp; college algebra · 12 chapters · {allLessons.length} lessons</div>
        <h1>Learn algebra by <em>doing</em> it.</h1>
        <p class="hero-lede">
          Every lesson follows the same rhythm: why it matters, the idea with an interactive picture, worked examples
          revealed one step at a time, the traps to avoid, unlimited practice with instant feedback, and a short
          mastery check.
        </p>
        <div class="hero-cta">
          <a class="btn btn-primary" href={available[first.id]}>Start with {first.id} {first.title} →</a>
          <a class="btn" href="#map">See the course map</a>
        </div>
      </div>
      <ol class="rhythm" aria-label="How every lesson works">
        <li><b>Why?</b> A real situation that needs the idea</li>
        <li><b>See it</b> Sliders and pictures you can play with</li>
        <li><b>Worked examples</b> One step at a time</li>
        <li><b>Watch out</b> The mistakes everyone makes</li>
        <li><b>Practice</b> Fresh problems, hints, instant checking</li>
        <li><b>Mastery</b> Prove it, unlock the next lesson</li>
      </ol>
    </div>
  </section>

  <section class="container" id="map">
    <h2 class="map-title">Course map</h2>
    <CourseMap client:load chapters={curriculum} available={available} />
  </section>
</Base>

<style>
  .hero { padding: 56px 0 40px; background: linear-gradient(180deg, var(--olive-soft), transparent); }
  .hero-inner { display: grid; grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr); gap: 48px; align-items: center; }
  .hero-kicker { color: var(--red); font-weight: 650; font-size: 0.85rem; letter-spacing: 0.04em; }
  .hero h1 { font-size: clamp(2.3rem, 6vw, 3.6rem); margin: 0.2em 0 0.3em; }
  .hero h1 em { color: var(--red); }
  .hero-lede { font-size: 1.12rem; color: var(--ink-2); max-width: 36em; }
  .hero-cta { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 20px; }
  .hero-cta a { text-decoration: none; }
  .rhythm { list-style: none; counter-reset: r; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 8px; }
  .rhythm li { counter-increment: r; display: grid; grid-template-columns: 30px 1fr; column-gap: 12px; background: var(--card); border: 1px solid var(--line); border-radius: 12px; padding: 9px 14px; font-size: 0.9rem; color: var(--ink-2); box-shadow: var(--shadow); }
  .rhythm li::before { content: counter(r); grid-row: span 2; width: 26px; height: 26px; border-radius: 50%; background: var(--red); color: white; display: grid; place-items: center; font-weight: 700; font-size: 0.8rem; align-self: center; }
  .rhythm b { color: var(--ink); }
  .map-title { margin-top: 1.4em; }
  @media (max-width: 860px) { .hero-inner { grid-template-columns: 1fr; gap: 28px; } }
</style>
